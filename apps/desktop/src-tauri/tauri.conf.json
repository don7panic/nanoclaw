{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoClaw Setup Control",
  "version": "0.1.0",
  "identifier": "com.nanoclaw.setup",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NanoClaw Setup Control",
        "width": 1520,
        "height": 940,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
